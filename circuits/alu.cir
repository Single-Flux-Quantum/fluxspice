X_18_or_result n_16 n_17 CLK n_18 OR2T
X_21_xor_result n_19 n_20 CLK n_21 XORT
X_30_result n_29 CLK n_30 DFFT
X_32_zero_flag n_31 CLK n_32 DFFT
